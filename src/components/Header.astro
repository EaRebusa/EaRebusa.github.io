---
import { Github, FileText } from 'lucide-astro';
---

<header class="sticky top-0 z-50 w-full border-b border-border bg-[#090a0f]/85 backdrop-blur-md">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
    <!-- Left: Identity & Availability -->
    <div class="flex items-center gap-3">
      <a href="/" class="font-mono font-bold text-lg tracking-tight text-white hover:text-cyan-status transition-colors">
        Earl John Rebusa
      </a>
      <div class="hidden sm:flex items-center gap-2 px-2.5 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-xs text-emerald-400 font-mono">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        Available for IT & Systems Roles
      </div>
    </div>

    <!-- Right: Navigation & Actions -->
    <nav class="flex items-center gap-4 sm:gap-6 text-sm text-[#9ca3af]">
      <a href="#projects" class="hover:text-white transition-colors">Projects</a>
      <a href="#skills" class="hover:text-white transition-colors">Skills</a>
      <a href="#contact" class="hover:text-white transition-colors">Contact</a>
      
      <div class="h-4 w-px bg-border hidden sm:block"></div>

      <a
        href="/resume.pdf"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md text-xs font-mono font-medium text-white bg-surface hover:bg-surface-hover border border-border hover:border-border-active transition-all"
      >
        <FileText class="w-3.5 h-3.5 text-cyan-status" />
        Resume
      </a>

      <a
        href="https://github.com/EaRebusa"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub Profile"
        class="text-[#9ca3af] hover:text-white transition-colors"
      >
        <Github class="w-5 h-5" />
      </a>
    </nav>
  </div>
</header>
